---
// Нейтральная заглушка вместо картинки: фон из палитры, заданные пропорции, подпись по центру.
interface Props {
  /** Подпись по центру, например «Фото» или название компании */
  label: string;
  /** Соотношение сторон в формате CSS aspect-ratio: «4/5», «16/10» */
  ratio: string;
}

const { label, ratio } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${ratio}`}>
  <span class="label">{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    padding: var(--space-6);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        var(--color-line) 14px 15px
      ),
      var(--color-surface);
    overflow: hidden;
  }

  .label {
    max-width: 100%;
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }
</style>
