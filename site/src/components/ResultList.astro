---
// Метрики результатов: value крупно, чернилами на полосе-маркере, label мелко и спокойно.
// Если результатов нет — компонент ничего не выводит.
interface Result {
  value: string;
  label: string;
}

interface Props {
  results?: Result[];
  /** Сколько первых результатов показать; без limit — все (в карточке — 2) */
  limit?: number;
  /** card — компактно в карточке, header — крупнее в шапке кейса */
  variant: 'card' | 'header';
}

const { results = [], limit, variant } = Astro.props;
const items = limit === undefined ? results : results.slice(0, limit);
---

{
  items.length > 0 && (
    <ul class:list={['results', variant]}>
      {items.map((item) => (
        <li class="item">
          <span class="value">{item.value}</span>
          <span class="label">{item.label}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .results {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 15em;
  }

  /* Цифра — чернилами на полосе-маркере (нижние 40% высоты) */
  .value {
    align-self: flex-start;
    margin-left: -0.12em;
    padding: 0 0.12em;
    background: linear-gradient(to top, var(--color-mark) 0 40%, transparent 40%);
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  /* Карточка: ровно два результата в одну строку, две равные колонки */
  .card {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    width: 100%;
  }

  .card .item {
    max-width: none;
  }

  .card .value {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .header {
    gap: var(--space-6) var(--space-12);
  }

  .header .value {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
</style>
