---
// Общий каркас всех страниц: <head> с мета-тегами, глобальные стили, <main> со слотом, футер.
// Именованный слот «header» — для верхней панели страниц (выводится до <main>).
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Картинка для og:image — обрабатывается в этапе 8 */
  ogImage?: ImageMetadata;
  /** Цель Метрики, отправляемая при загрузке страницы, — обрабатывается в этапе 8 */
  goalOnLoad?: string;
}

const { title, description } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Футер прижат к низу окна даже на коротких страницах (404) */
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
