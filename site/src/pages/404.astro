---
// Страница для несуществующих адресов.
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base title={`Страница не найдена — ${site.name}`} description="Такой страницы нет на сайте.">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="code">404</p>
    <h1 id="not-found-title" class="title">Страница не найдена</h1>
    <p class="text">Возможно, адрес набран с ошибкой или страница была удалена.</p>
    <a class="home" href="/">На главную</a>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-24) var(--gutter);
  }

  .code {
    color: var(--color-accent);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.75rem);
  }

  .text {
    color: var(--color-text-muted);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-6);
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition);
  }

  .home:hover {
    background: var(--color-accent-hover);
  }
</style>
