---
// ВРЕМЕННАЯ главная (шаг 3.8): список заголовков кейсов. Заменяется в этапе 5.
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { getPublishedCases } from '../lib/cases';

const cases = await getPublishedCases();
---

<Base title={`${site.name} — ${site.role}`} description={site.seoDescription}>
  <ol>
    {cases.map((entry) => <li>{entry.data.title}</li>)}
  </ol>
</Base>
